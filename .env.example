# Copy this file to `.env` (a hidden file) next to docker-compose.yml and edit the copy. It is never committed.
# One KEY=value per line, comments only on their own lines, avoid the dollar sign in values.

# The first account can always be created. After that, sign-ups are closed unless you set this to 1.
BT_ALLOW_REGISTRATION=0

# Optional. When extra sign-ups are open (1), people must also enter this phrase. Empty = no code.
BT_REGISTER_CODE=

# Port on the Unraid server the app answers on (Work Hours uses 5005).
BT_PORT=5006

# Where the database and session key live on the server.
BT_DATA_DIR=/mnt/user/appdata/billstracker

# 1 = cookies are https-only (needed behind the Cloudflare Tunnel). Set 0 only to test over http on your home network.
BT_HTTPS=1
